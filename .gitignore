node_modules/
*.log
state.json
config.json

# Установщики лежат в репозитории: приложение ставит недостающее само, в том
# числе на машине без интернета. Скрипт scripts/fetch-installers.mjs остаётся
# для обновления версий — он же сверяет суммы.

# Собранные комплекты: node.exe и архив, в репозитории им не место.
# Собираются заново командой npm run build.
dist/

# Раскладка с лаунчером: появляется только в собранном комплекте и в установке
# (а при ручной проверке — рядом с кодом), в репозиторий не относится.
/app/
/releases/
/download/
/installed.json

# Локальные журналы сборки и личные пометки, в репозиторий не относятся.
# Без этого publish-release останавливается проверкой «дерево грязное».
/.logs/

# Результаты нагрузочных проверок: приносятся с другой машины, в репозиторий не попадают
# (иначе publish-release видит грязное дерево).
/result/*
!/result/.gitkeep

# Рабочее состояние сторожа go.md (дедлайн 12-часового окна)
/.go-watchdog.json
